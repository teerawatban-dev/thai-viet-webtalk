# Copy to `.env` and fill in. Never commit `.env`.

# --- Speech to text ------------------------------------------------------
# browser     -> Web Speech API in the browser: free, no key, no audio upload
# mock        -> no network, emits placeholder transcripts (works offline)
# soniox      -> real server-side realtime STT (needs STT_API_KEY)
STT_PROVIDER=browser
STT_API_KEY=
STT_MODEL=stt-rt-v4
# STT_WS_URL=wss://stt-rt.soniox.com/transcribe-websocket

# --- Translation ---------------------------------------------------------
# lingva      -> key-free public Google-proxy instances + MyMemory fallback
# passthrough -> no network, returns "[vi] <text>" (works offline)
# llm         -> any OpenAI-compatible /chat/completions endpoint (needs key)
TRANSLATE_PROVIDER=lingva
TRANSLATE_API_KEY=
TRANSLATE_MODEL=gpt-4o-mini
# TRANSLATE_BASE_URL=https://api.openai.com/v1
# in-house alternative (LAN only, not reachable from Render):
# TRANSLATE_BASE_URL=http://192.168.9.218:8181/v1

# --- App -----------------------------------------------------------------
DEFAULT_SRC_LANG=th
TARGET_LANGS=th,vi,en
MAX_ROOM_CLIENTS=6
MAX_ROOMS=100
ROOM_TTL_SECONDS=300
LOG_LEVEL=INFO
TTS_ENABLED=false
